<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jocelyne Jeyapal — Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Jost:wght@300;400;500&display=swapfamily=Jost:wght@300;400;500https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Jost:wght@300;400;500&display=swapdisplay=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --cream: #f2ede6;
  --cream-dark: #e8e1d8;
  --green: #1b2a4a;
  --green-mid: #253a62;
  --green-light: #e4e9f4;
  --off-white: #faf8f4;
  --black: #1a1a18;
  --gray: #7a7970;
  --gray-light: #c8c5bc;
}

html { scroll-behavior: smooth; }

body {
  font-family: 'Jost', sans-serif;
  background: var(--cream);
  color: var(--black);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* ─── NAV ─── */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  display: flex; justify-content: space-between; align-items: center;
  padding: 1.1rem 3.5rem;
  background: rgba(242,237,230,0.94);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--gray-light);
}
.nav-logo {
  font-family: 'Libre Baskerville', serif;
  font-style: italic; font-weight: 400; font-size: 1.15rem;
  color: var(--green); text-decoration: none; letter-spacing: 0.02em;
}
.nav-links { display: flex; gap: 2.5rem; list-style: none; }
.nav-links a {
  font-size: 0.72rem; font-weight: 400; letter-spacing: 0.13em;
  text-transform: lowercase; color: var(--gray); text-decoration: none;
  transition: color 0.2s;
}
.nav-links a:hover { color: var(--green); }

/* ─── HERO ─── */
.hero {
  min-height: 100vh; padding-top: 64px;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  text-align: center; padding: 120px 3rem 5rem;
  position: relative; overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute; inset: 0;
  background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(27,63,44,0.07) 0%, transparent 70%);
  pointer-events: none;
}
.hero-eyebrow {
  font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--green); margin-bottom: 2rem; font-weight: 400;
}
.hero-title {
  font-family: 'Libre Baskerville', serif;
  font-weight: 300; font-size: clamp(4rem, 10vw, 9rem);
  line-height: 0.95; letter-spacing: -0.01em;
  margin-bottom: 1.5rem; color: var(--black);
}
.hero-title em { font-style: italic; color: var(--green); display: block; }
.hero-subtitle {
  font-family: 'Libre Baskerville', serif;
  font-style: italic; font-size: clamp(1.1rem, 2.5vw, 1.6rem);
  color: var(--gray); font-weight: 300; margin-bottom: 3rem;
  max-width: 560px; line-height: 1.5;
}
.hero-cta { display: flex; gap: 1.25rem; justify-content: center; align-items: center; margin-bottom: 5rem; }
.btn-dark {
  background: var(--green); color: var(--off-white);
  text-decoration: none; padding: 0.8rem 2rem;
  font-size: 0.72rem; font-weight: 400; letter-spacing: 0.14em;
  text-transform: lowercase; transition: background 0.2s, transform 0.15s;
}
.btn-dark:hover { background: #0f1a30; transform: translateY(-1px); }
.btn-outline {
  color: var(--green); text-decoration: none; font-size: 0.72rem;
  letter-spacing: 0.14em; text-transform: lowercase;
  border-bottom: 1px solid var(--green); padding-bottom: 2px;
  transition: opacity 0.2s;
}
.btn-outline:hover { opacity: 0.6; }
.hero-stats {
  display: flex; gap: 0; border: 1px solid var(--gray-light);
  background: var(--off-white); max-width: 620px; width: 100%; margin: 0 auto;
}
.hero-stat {
  flex: 1; padding: 1.75rem 1.5rem; text-align: center;
  border-right: 1px solid var(--gray-light);
}
.hero-stat:last-child { border-right: none; }
.hero-stat-num {
  font-family: 'Libre Baskerville', serif;
  font-size: 2.2rem; font-weight: 300; color: var(--green); display: block; line-height: 1;
  margin-bottom: 0.35rem;
}
.hero-stat-label {
  font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--gray); font-weight: 400;
}

/* ─── SECTION BASE ─── */
section { padding: 6rem 3.5rem; }
.section-label {
  font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--green); display: flex; align-items: center; gap: 0.85rem;
  margin-bottom: 1.5rem; font-weight: 400;
}
.section-label::after { content: ''; flex: 0 0 40px; height: 1px; background: var(--green); }
.section-heading {
  font-family: 'Libre Baskerville', serif;
  font-weight: 300; font-size: clamp(2.8rem, 6vw, 5rem);
  line-height: 1.05; margin-bottom: 3.5rem;
}
.section-heading em { font-style: italic; color: var(--green); }

/* ─── ABOUT ─── */
.about { background: var(--off-white); border-top: 1px solid var(--gray-light); border-bottom: 1px solid var(--gray-light); }
.about-inner {
  display: grid; grid-template-columns: 1fr 1fr; gap: 6rem;
  align-items: start; max-width: 1100px; margin: 0 auto;
}
.about-photo-wrap {
  position: relative; display: flex; justify-content: center;
}
.about-photo-frame {
  width: 340px; height: 420px;
  background: var(--cream-dark);
  border: 2px solid var(--green);
  display: flex; align-items: center; justify-content: center;
  position: relative; overflow: hidden;
}
.about-photo-frame::before {
  content: '';
  position: absolute; inset: 8px;
  border: 1px solid var(--green-light);
  z-index: 1; pointer-events: none;
}
.about-photo-inner {
  width: 100%; height: 100%; object-fit: cover;
  filter: sepia(10%) saturate(90%);
}
.about-photo-placeholder {
  width: 100%; height: 100%;
  background: linear-gradient(145deg, var(--green-light) 0%, var(--cream-dark) 100%);
  display: flex; align-items: center; justify-content: center;
  font-family: 'Libre Baskerville', serif; font-style: italic;
  font-size: 1.1rem; color: var(--green); opacity: 0.6;
}
.about-content { padding-top: 0.5rem; }
.about-text p {
  font-size: 1rem; color: var(--gray); line-height: 1.9;
  margin-bottom: 1.25rem; font-weight: 300;
}
.about-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2rem; }
.chip {
  font-size: 0.68rem; letter-spacing: 0.1em; text-transform: lowercase;
  padding: 0.4rem 1rem; border: 1px solid var(--green);
  color: var(--green); background: transparent;
}

/* ─── WORK ─── */
.work { background: var(--cream); }
.work-inner { max-width: 1100px; margin: 0 auto; }
.work-list { display: flex; flex-direction: column; gap: 0; border: 1px solid var(--gray-light); }
.work-item {
  display: grid; grid-template-columns: 1fr 2fr 1fr;
  align-items: start; padding: 2.5rem;
  border-bottom: 1px solid var(--gray-light);
  transition: background 0.2s; cursor: default; background: var(--off-white);
  gap: 2rem;
}
.work-item:last-child { border-bottom: none; }
.work-item:hover { background: var(--green-light); }
.work-meta {}
.work-tag {
  font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--green); font-weight: 500; display: block; margin-bottom: 0.6rem;
}
.work-client-name {
  font-family: 'Libre Baskerville', serif;
  font-style: italic; font-size: 1.5rem; font-weight: 400;
  color: var(--black); line-height: 1.2; margin-bottom: 0.3rem;
}
.work-date { font-size: 0.72rem; color: var(--gray); letter-spacing: 0.06em; }
.work-body {}
.work-desc { font-size: 0.9rem; color: var(--gray); line-height: 1.75; font-weight: 300; }
.work-numbers { display: flex; flex-direction: column; gap: 1rem; align-items: flex-end; }
.work-num-item { text-align: right; }
.work-num-val {
  font-family: 'Libre Baskerville', serif;
  font-size: 1.8rem; font-weight: 300; color: var(--green); display: block; line-height: 1;
}
.work-num-key { font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gray); }

/* ─── SOCIAL PAGES ─── */
.social { background: var(--off-white); border-top: 1px solid var(--gray-light); border-bottom: 1px solid var(--gray-light); }
.social-inner { max-width: 1100px; margin: 0 auto; }
.social-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
.social-card {
  background: var(--cream); border: 1px solid var(--gray-light);
  padding: 2rem; transition: border-color 0.2s, transform 0.2s;
}
.social-card:hover { border-color: var(--green); transform: translateY(-3px); }
.social-platform {
  font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--green); margin-bottom: 1rem; font-weight: 500;
}
.social-handle {
  font-family: 'Libre Baskerville', serif;
  font-style: italic; font-size: 1.4rem; color: var(--black);
  margin-bottom: 0.3rem;
}
.social-niche { font-size: 0.8rem; color: var(--gray); margin-bottom: 1.5rem; font-weight: 300; }
.social-stats-row { display: flex; gap: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--gray-light); }
.s-stat-val {
  font-family: 'Libre Baskerville', serif;
  font-size: 1.6rem; font-weight: 300; color: var(--green); display: block; line-height: 1;
}
.s-stat-key { font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gray); }

/* ─── TOOLS ─── */
.tools { background: var(--cream); }
.tools-inner { max-width: 1100px; margin: 0 auto; }
.tools-grid {
  display: grid; grid-template-columns: repeat(4, 1fr);
  border: 1px solid var(--gray-light); gap: 0;
}
.tool-item {
  background: var(--off-white); padding: 2.5rem 1.5rem;
  display: flex; flex-direction: column; align-items: center; gap: 1rem;
  border-right: 1px solid var(--gray-light); border-bottom: 1px solid var(--gray-light);
  transition: background 0.2s;
}
.tool-item:hover { background: var(--green-light); }
.tool-icon {
  width: 56px; height: 56px; border-radius: 50%;
  border: 1px solid var(--gray-light); background: var(--cream);
  display: flex; align-items: center; justify-content: center; font-size: 1.5rem;
}
.tool-name {
  font-size: 0.72rem; letter-spacing: 0.08em; text-transform: lowercase;
  color: var(--gray); text-align: center; font-weight: 400;
}

/* ─── CONTACT ─── */
.contact { background: var(--green); }
.contact .section-label { color: var(--green-light); }
.contact .section-label::after { background: var(--green-light); }
.contact-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: start; }
.contact-left {}
.contact-heading {
  font-family: 'Libre Baskerville', serif;
  font-weight: 300; font-size: clamp(2.5rem, 5vw, 4.5rem);
  line-height: 1.05; color: var(--off-white); margin-bottom: 1.5rem;
}
.contact-heading em { font-style: italic; color: var(--cream-dark); }
.contact-sub { font-size: 0.95rem; color: rgba(250,248,244,0.65); line-height: 1.8; margin-bottom: 2.5rem; font-weight: 300; }
.contact-email-link {
  display: inline-block; font-family: 'Libre Baskerville', serif;
  font-style: italic; font-size: 1.2rem;
  color: var(--off-white); text-decoration: none;
  border-bottom: 1px solid rgba(250,248,244,0.35); padding-bottom: 3px;
  transition: border-color 0.2s;
}
.contact-email-link:hover { border-color: var(--off-white); }
.contact-form { display: flex; flex-direction: column; gap: 1.5rem; }
.form-group { display: flex; flex-direction: column; gap: 0.4rem; }
.form-group label {
  font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase;
  color: rgba(250,248,244,0.5); font-weight: 400;
}
.form-group input, .form-group textarea, .form-group select {
  background: transparent; border: none;
  border-bottom: 1px solid rgba(250,248,244,0.25);
  padding: 0.6rem 0; font-family: 'Jost', sans-serif; font-size: 0.9rem;
  color: var(--off-white); outline: none; transition: border-color 0.2s;
  appearance: none;
}
.form-group input::placeholder, .form-group textarea::placeholder { color: rgba(250,248,244,0.3); }
.form-group input:focus, .form-group textarea:focus, .form-group select:focus { border-color: rgba(250,248,244,0.7); }
.form-group select option { background: var(--green); color: var(--off-white); }
.form-group textarea { resize: none; min-height: 80px; }
.btn-submit {
  background: var(--off-white); color: var(--green); border: none;
  padding: 0.85rem 2rem; font-family: 'Jost', sans-serif;
  font-size: 0.72rem; font-weight: 400; letter-spacing: 0.14em; text-transform: lowercase;
  cursor: pointer; align-self: flex-start; transition: background 0.2s, transform 0.15s;
}
.btn-submit:hover { background: var(--cream); transform: translateY(-1px); }

/* ─── FOOTER ─── */
footer {
  background: var(--green); border-top: 1px solid rgba(255,255,255,0.1);
  padding: 1.75rem 3.5rem;
  display: flex; justify-content: space-between; align-items: center;
}
.footer-copy { font-size: 0.7rem; color: rgba(250,248,244,0.4); letter-spacing: 0.06em; }
.footer-links { display: flex; gap: 2rem; list-style: none; }
.footer-links a {
  font-size: 0.7rem; color: rgba(250,248,244,0.45); text-decoration: none;
  letter-spacing: 0.08em; text-transform: lowercase; transition: color 0.2s;
}
.footer-links a:hover { color: var(--off-white); }

/* ─── DIVIDER ─── */
.divider {
  height: 1px; background: var(--gray-light);
  margin: 0 3.5rem;
}

/* ─── ANIMATIONS ─── */
.fade-up { opacity: 0; transform: translateY(28px); transition: opacity 0.75s ease, transform 0.75s ease; }
.fade-up.visible { opacity: 1; transform: none; }

/* ─── RESPONSIVE ─── */
@media (max-width: 960px) {
  nav { padding: 1rem 1.5rem; }
  .nav-links { display: none; }
  section { padding: 4rem 1.5rem; }
  .about-inner, .contact-inner { grid-template-columns: 1fr; gap: 3rem; }
  .about-photo-frame { width: 100%; max-width: 320px; height: 340px; }
  .work-item { grid-template-columns: 1fr; gap: 1rem; }
  .work-numbers { align-items: flex-start; flex-direction: row; }
  .work-num-item { text-align: left; }
  .social-grid { grid-template-columns: 1fr; }
  .tools-grid { grid-template-columns: repeat(2, 1fr); }
  .hero-stats { flex-direction: column; max-width: 320px; }
  .hero-stat { border-right: none; border-bottom: 1px solid var(--gray-light); }
  .hero-stat:last-child { border-bottom: none; }
  footer { flex-direction: column; gap: 1rem; padding: 1.5rem; text-align: center; }
  .divider { margin: 0 1.5rem; }
}
</style>
</head>
