        <span class="chip">ugc</span>
        <span class="chip">influencer marketing</span>
        <span class="chip">meta ads</span>
        <span class="chip">community building</span>
        <span class="chip">creator vetting</span>
        <span class="chip">strategy</span>
      </div>
    </div>
  </div>
</section>

<!-- WORK -->
<section class="work" id="work">
  <div class="work-inner">
    <p class="section-label fade-up">creator vetting & strategy</p>
    <h2 class="section-heading fade-up">My <em>work</em></h2>
    <div class="work-list">

      <div class="work-item fade-up">
        <div class="work-meta">
          <span class="work-tag">Social Media Team</span>
          <span class="work-client-name">Social with Kat</span>
          <span class="work-date">September 2025 — present</span>
        </div>
        <div class="work-body">
          <p class="work-desc">Recruited to join the social media team for Social with Kat — a brand helping women turn digital skills into travel freedom. I work closely with the founder to create content focused around marketing, social media, and travel. I help create content, generate ideas, post to social media, and run ads on Facebook and Instagram.</p>
